{
    "name": "fostenslave/query-builder",
    "description": "Immutable, inspired by Laravel, PDO-based SQL query builder with compile-time dialect support (SQLite, MySQL, PostgreSQL)",
    "version": "0.1",
    "type": "library",
    "license": "MIT",
    "keywords": ["query-builder", "sql", "pdo", "sqlite", "mysql"],
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*"
    },
    "authors": [
        {
            "name": "Vyacheslav Prudovskiy",
            "email": "slavec56@gmail.com",
            "role": "Creator"
        }
    ],
    "support": {
        "email": "slavec56@gmail.com",
        "issues": "https://github.com/Fostenslave/simple-query-builder/issues"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-pdo_mysql": "For MySQL support",
        "ext-pdo_pgsql": "For PostgreSQL support"
    },
    "autoload": {
        "psr-4": {
            "Fostenslave\\QueryBuilder\\": "src/"

        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fostenslave\\QueryBuilder\\Tests\\": "tests/"
        }
    }
}